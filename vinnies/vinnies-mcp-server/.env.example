# Names only -- put values in vinnies-mcp-server/.env (gitignored).
# Load before running:  set -a && source .env && set +a

# HTTP port for the MCP server (default 8081; Rootstock uses 8080)
VINNIES_MCP_PORT=

# Database. For the demo this is RootStock's database and login; the mock app
# keeps its tables in its own schema (see db/setup.sql).
VINNIES_DB_URL=
VINNIES_DB_USERNAME=
VINNIES_DB_PASSWORD=
# Schema for the app's tables (default vinnies_mock)
VINNIES_DB_SCHEMA=
