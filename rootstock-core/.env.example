# Names only -- put values in rootstock-core/.env (gitignored, never committed).
# Load before running:  set -a && source .env && set +a
# Other settings have defaults in application.yml; see the README's Configuration table.

# AWS identity and region (the app's scoped IAM user, never root/admin)
AWS_PROFILE=
AWS_REGION=

# App database (PostgreSQL on RDS/Aurora)
DB_URL=
DB_USERNAME=
DB_PASSWORD=

# Langfuse tracing (no-op until both keys are set)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=

# Client systems Rootstock calls over MCP: path to a domain's tools file, e.g.
# <repo>/vinnies/vinnies-pack/packs/vinnies/tools.yaml. Unset: no MCP connections.
ROOTSTOCK_TOOLS_FILE=

# Machine-to-machine access to the Vinnies MCP server (Cognito client credentials),
# used by that tools file
VINNIES_MCP_URL=
VINNIES_MCP_CLIENT_ID=
VINNIES_MCP_CLIENT_SECRET=
VINNIES_MCP_TOKEN_URL=
