{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rootstock.sinewlabs.example/schemas/agent.schema.json",
  "title": "Rootstock agent",
  "description": "One agent in a domain pack (agents/<name>.yaml): its building-block type, model, prompt, inputs, output and limits.",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "rootstock/v1" },
    "kind": { "const": "Agent" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "version": { "type": "string" },
        "description": { "type": "string" }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "output"],
      "properties": {
        "type": { "type": "string" },
        "model": { "type": "string" },
        "prompt": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name"],
          "properties": {
            "name": { "type": "string" },
            "label": { "type": "string" }
          }
        },
        "input": {
          "type": "object",
          "additionalProperties": { "type": "string", "pattern": "^\\$\\." }
        },
        "output": {
          "type": "object",
          "additionalProperties": false,
          "required": ["writeTo"],
          "properties": {
            "projection": { "type": "string" },
            "writeTo": { "type": "string" }
          }
        },
        "tools": {
          "type": "object",
          "additionalProperties": false,
          "required": ["connection", "allow"],
          "properties": {
            "connection": { "type": "string" },
            "allow": { "type": "array", "minItems": 1, "items": { "type": "string" } }
          }
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "timeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 600 },
            "retries": { "type": "integer", "minimum": 0, "maximum": 5 },
            "maxIterations": { "type": "integer", "minimum": 1, "maximum": 10 }
          }
        }
      }
    }
  }
}
