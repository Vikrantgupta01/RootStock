{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rootstock.sinewlabs.example/schemas/graph.schema.json",
  "title": "Rootstock graph",
  "description": "A domain pack's case-processing graph (graph.yaml): state channels, nodes, edges and runtime settings.",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "nodes", "edges"],
  "properties": {
    "apiVersion": { "const": "rootstock/v1" },
    "kind": { "const": "Graph" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "version": { "type": "string" },
        "pack": { "type": "string" },
        "description": { "type": "string" }
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "channels": {
          "type": "object",
          "propertyNames": { "pattern": "^[a-z][A-Za-z0-9]*$" },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["reducer"],
            "properties": {
              "reducer": { "enum": ["replace", "merge", "append"] },
              "description": { "type": "string" }
            }
          }
        }
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "type": { "type": "string" },
          "agent": { "type": "string" },
          "description": { "type": "string" },
          "config": { "type": "object" }
        }
      }
    },
    "edges": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from"],
        "properties": {
          "from": { "type": "string" },
          "to": { "type": "string" },
          "router": { "type": "string" },
          "targets": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "route": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "when": {
                  "type": "object",
                  "minProperties": 1,
                  "additionalProperties": {
                    "anyOf": [
                      { "type": ["string", "number", "boolean"] },
                      { "type": "array", "items": { "type": ["string", "number", "boolean"] } }
                    ]
                  }
                },
                "to": { "type": "string" },
                "default": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "checkpointer": { "enum": ["memory", "postgres"] },
        "interruptBefore": { "type": "array", "items": { "type": "string" } },
        "interruptAfter": { "type": "array", "items": { "type": "string" } },
        "maxSteps": { "type": "integer", "minimum": 1, "maximum": 500 }
      }
    }
  }
}
